# Template: scripts/install-production.sh renders the ${PERSEVERER_*} placeholders from perseverer.env
# and installs the result -- don't install this file directly. See docs/DEPLOY.md.
# See perseverer-api.container for the shared design notes. No data volume -- the frontend
# image is stateless (static assets + nginx), same as compose.yaml's frontend service.

[Unit]
Description=Perseverer frontend
After=network-online.target
Wants=network-online.target

[Container]
Image=${PERSEVERER_IMAGE_PREFIX}/perseverer-frontend:${PERSEVERER_IMAGE_TAG}
ContainerName=perseverer-frontend
AutoUpdate=registry
# config.js (API URL, map key) and the nginx upstream port are rendered from this file at
# container start -- see docker/frontend-entrypoint.d and docker/nginx.conf.template.
EnvironmentFile=%h/.config/containers/systemd/perseverer.env
PublishPort=${PERSEVERER_HOST_FRONTEND_PORT}:80
PodmanArgs=--memory=128m

[Service]
Restart=always

[Install]
WantedBy=default.target
