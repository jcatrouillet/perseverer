# Template: scripts/install-production.sh renders the ${PERSEVERER_*} placeholders from perseverer.env
# and installs the result -- don't install this file directly. See docs/DEPLOY.md.
# Rootless, user-level (installed to ~/.config/containers/systemd/), managed by `systemctl --user`.

[Unit]
Description=Perseverer API
After=network-online.target
Wants=network-online.target

[Container]
Image=${PERSEVERER_IMAGE_PREFIX}/perseverer-api:${PERSEVERER_IMAGE_TAG}
ContainerName=perseverer-api
# Lets `podman auto-update` (podman-auto-update.timer) pull a newer digest under the same
# :latest tag and restart automatically -- images are only ever built in CI or on the dev host
# (never on this host), so this is the pull step, not a build trigger.
AutoUpdate=registry
EnvironmentFile=%h/.config/containers/systemd/perseverer.env
Environment=TZ=${PERSEVERER_SCHEDULE_TIMEZONE}
# Bind mount, not a Podman-managed named volume: this project's whole ethos is an inspectable,
# directly-browsable data archive (raw bytes + SQLite + Parquet you can rsync/back up with plain
# file tools), not something opaque under Podman's own storage tree. The Dockerfile's own `USER
# perseverer` (uid 1000) needs the host directory owned to match under rootless Podman's user
# namespace -- see the one-time `podman unshare chown` step in docs/DEPLOY.md.
Volume=${PERSEVERER_HOST_DATA_DIR}:/data
PublishPort=${PERSEVERER_HOST_API_PORT}:8000
HealthCmd=["python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/v1/healthz', timeout=3)"]
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=10s
# 2g: a bulk import (adapters/apple_health_export.py reads an entire multi-GB export.xml
# into memory before archiving it) is OOM-killed at 512m.
PodmanArgs=--memory=2g
# Hardening: the only path this container writes to is /data (bind mounted
# above) -- the bulk-import upload endpoint streams to `settings.data_dir / "tmp"`, not the
# OS /tmp, and DuckDB's own temp_directory is explicitly pointed under /data too
# (api/duckdb_conn.py) specifically because of this. See perseverer-worker.container's own
# comment for why ReadOnlyTmpfs= is set explicitly rather than left to default.
ReadOnly=true
ReadOnlyTmpfs=true
NoNewPrivileges=true

[Service]
Restart=always

[Install]
WantedBy=default.target
