# Copy to ~/.config/containers/systemd/perseverer.env on the deploy host and fill in. Never
# commit the real file. Shared across all three .container units via EnvironmentFile= --
# api/worker/frontend each just ignore whatever keys they don't use.

PERSEVERER_ENVIRONMENT=production
PERSEVERER_LOG_LEVEL=INFO

# --- api ---
# Shared secret required via the X-API-Key header on every data route. Unset -> those routes
# fail closed (503), never open (see docs/adr/0006-phase-3-read-api-and-rollups.md decision 6).
PERSEVERER_API_KEY=
# Comma-separated CORS origins for the frontend's hostname(s); unset -> no CORS middleware.
PERSEVERER_CORS_ALLOWED_ORIGINS=
# Signs session JWTs issued by POST /api/v1/auth/login. Unset -> that route fails closed (503),
# same fail-closed contract as PERSEVERER_API_KEY. Generate with e.g. `openssl rand -hex 32`.
PERSEVERER_JWT_SECRET=
PERSEVERER_JWT_EXPIRY_DAYS=30
# The externally-visible origin a /share/{token} link should point at, e.g.
# "https://perseverer.example.com" -- NOT the same value as PERSEVERER_API_BASE_URL below when
# the reverse proxy fronts the api and frontend containers on different ports (see docs/DEPLOY.md
# -- bercy's api rule lives on :444, but /share/* is proxied through the frontend's own :443
# origin, sharing.py's own docstring). Unset -> falls back to the incoming request's own base
# URL, which is wrong whenever the create-share request itself arrives on the api's own port.
PERSEVERER_PUBLIC_BASE_URL=

# --- frontend ---
# Regenerated into frontend/public/config.js at container start (docker/frontend-entrypoint.d)
# -- whichever hostname/URL resolves correctly for wherever the browser actually is. See
# docs/DEPLOY.md's split-horizon-DNS note.
PERSEVERER_API_BASE_URL=
# CARTO basemap API key (frontend/src/mapBasemap.ts) -- not actually secret, CARTO's basemap
# product is designed for client-side embedding like a Mapbox public token, so this is a real
# usable default rather than a blank placeholder. Free tier is a 5M-tiles/month fair-use ceiling
# shared across every athlete/browser hitting this deployment: get carto.com/basemaps/apikey/
PERSEVERER_CARTO_API_KEY=cb1_2idi_1_ce8832025c922954b1c9138e

# --- worker: garmin_connect adapter ---
PERSEVERER_GARMIN_ROLLING_WINDOW_DAYS=10
PERSEVERER_GARMIN_REQUEST_INTERVAL_S=3.0
PERSEVERER_GARMIN_MAX_REQUESTS_PER_HOUR=300
PERSEVERER_GARMIN_STALE_ESCALATE_DAYS=7
PERSEVERER_EXPORT_FRESHNESS_DAYS=90
PERSEVERER_STALENESS_WEBHOOK_URL=
PERSEVERER_SCHEDULE_HOUR=4
PERSEVERER_SCHEDULE_MINUTE=15
PERSEVERER_SCHEDULE_JITTER_S=600
# IANA name, e.g. "America/Los_Angeles" -- resolves hour/minute against this zone's own wall
# clock (correct across DST), not the container's own system clock (bercy's is UTC). Defaults to
# UTC if unset, matching hour/minute's own pre-timezone-support behavior.
PERSEVERER_SCHEDULE_TIMEZONE=UTC

# --- worker: Eufy Life body-composition sync ---
# All four optional together -- sync_eufy() just skips (logs, doesn't error) when unset.
PERSEVERER_EUFY_EMAIL=
PERSEVERER_EUFY_PASSWORD=
PERSEVERER_EUFY_DEVICE_ID=
PERSEVERER_EUFY_CUSTOMER_ID=

# --- worker: backup + restore automation (Phase 9, ADR 0014) ---
# All three optional together -- create_backup() logs and skips (doesn't error) when unset, same
# contract as Eufy above. rsync's destination: another host on your LAN, reachable over SSH.
# One-time manual step before this works: `ssh-copy-id -i <key> PERSEVERER_BACKUP_USER@PERSEVERER_BACKUP_HOST`
# from bercy itself -- this app has no way to provision credentials on a host it doesn't control,
# see docs/DEPLOY.md's Backups section.
PERSEVERER_BACKUP_HOST=
PERSEVERER_BACKUP_USER=
PERSEVERER_BACKUP_PATH=
# Only needed if the backup step must use a specific key rather than the invoking user's default
# (~/.ssh/id_ed25519 etc.).
PERSEVERER_BACKUP_SSH_KEY_PATH=
PERSEVERER_BACKUP_SCHEDULE_HOUR=3
PERSEVERER_BACKUP_SCHEDULE_MINUTE=30
# How many local timestamped DB snapshots to keep under <data>/backups/ before pruning -- the
# remote rsync copy is the real backup and is left to accumulate full history; this only bounds
# bercy's own local disk usage.
PERSEVERER_BACKUP_KEEP_LOCAL_SNAPSHOTS=7

# Scheduled workouts: a planned workout is automatically pushed to the Garmin watch once its
# date is within this many days (worker/main.py::run_daily_workout_push, own schedule right
# after the daily sync) -- "push now" (the Settings/calendar UI button) bypasses this window.
PERSEVERER_PLANNED_WORKOUT_PUSH_WINDOW_DAYS=7
PERSEVERER_WORKOUT_PUSH_SCHEDULE_HOUR=4
PERSEVERER_WORKOUT_PUSH_SCHEDULE_MINUTE=45

# --- worker + api: weekly/monthly email reports (email_reports.py) ---
# One shared SMTP relay for the whole deployment (not a per-athlete credential). All six SMTP
# keys optional together -- the scheduled jobs and the "send test email" button log-and-skip
# when any of host/username/password/from is unset. Recipients are each athlete's own
# `athlete.email` (Settings > Profile); the two per-athlete opt-in switches live in Settings
# (off by default). PORT 587 is mail submission and uses STARTTLS ("starttls"); implicit TLS is
# port 465 ("ssl"). OVH's ssl0.ovh.net serves both.
PERSEVERER_SMTP_HOST=
PERSEVERER_SMTP_PORT=587
PERSEVERER_SMTP_USERNAME=
PERSEVERER_SMTP_PASSWORD=
PERSEVERER_SMTP_FROM=
PERSEVERER_SMTP_SECURITY=starttls
# When the reports go out, resolved against PERSEVERER_SCHEDULE_TIMEZONE. Weekly fires on this
# weekday, monthly on the month's last day, both at this hour:minute. Defaults: Sunday 18:00.
PERSEVERER_EMAIL_REPORT_HOUR=18
PERSEVERER_EMAIL_REPORT_MINUTE=0
PERSEVERER_EMAIL_REPORT_WEEKLY_DAY_OF_WEEK=sun
