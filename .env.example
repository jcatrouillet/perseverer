# Copy to .env and adjust. Never commit the real .env — see .gitignore.
# `podman compose` (dev, Windows/Podman Desktop) auto-merges compose.yaml + compose.override.yml.
# The NAS runs Docker (DSM Container Manager) and uses compose.nas.yml explicitly:
# `docker compose -f compose.yaml -f compose.nas.yml up -d`

# --- App config (perseverer.config.Settings — env overrides config/default.toml) ---
PERSEVERER_ENVIRONMENT=development
PERSEVERER_LOG_LEVEL=INFO
PERSEVERER_API_PORT=8000
# For HOST-SIDE tooling only (uv run alembic, uv run python -m perseverer.cli) — a local
# path relative to the repo root, gitignored. NOT read by the containers: compose.yaml
# hardcodes /data (the mount point) directly rather than templating it from here, since a
# container-internal path and a host-side path are never the same value.
PERSEVERER_DATA_DIR=./data

# --- Phase 2: garmin_connect adapter ---
# Only ever used interactively by `sync auth login`, never by the scheduler/CLI import
# commands (which only ever load the token store — see adapters/garmin_connect.py).
# GARMIN_EMAIL=
# GARMIN_PASSWORD=
# Rolling re-fetch window: Garmin retroactively revises sleep/body battery/training status,
# so a pure high-watermark sync would silently lose corrections.
PERSEVERER_GARMIN_ROLLING_WINDOW_DAYS=10
# Throttle between requests and a hard per-hour cap. On a 429, the run aborts immediately —
# no retry loop, ever (Garmin's SSO 429-locks per account with no recovery path).
PERSEVERER_GARMIN_REQUEST_INTERVAL_S=3.0
PERSEVERER_GARMIN_MAX_REQUESTS_PER_HOUR=300
# Days without a successful garmin_connect run before the staleness webhook escalates from
# "warning" to "critical" — past this point it's a data-loss clock, not an inconvenience.
PERSEVERER_GARMIN_STALE_ESCALATE_DAYS=7
# Days since athlete.last_full_export_at before nagging for a fresh Garmin export archive.
PERSEVERER_EXPORT_FRESHNESS_DAYS=90
# Outbound webhook (generic JSON POST) for staleness/ingest alerts, e.g. a WhatsApp gateway.
# PERSEVERER_STALENESS_WEBHOOK_URL=
# Daily scheduler time (worker container), local time, plus a jitter window in seconds.
PERSEVERER_SCHEDULE_HOUR=4
PERSEVERER_SCHEDULE_MINUTE=15
PERSEVERER_SCHEDULE_JITTER_S=600

# --- Phase 3: read API ---
# Shared secret required via the X-API-Key header on every data route. Unset -> those routes
# fail closed (503), never open (see docs/adr/0006-phase-3-read-api-and-rollups.md decision 6).
# PERSEVERER_API_KEY=
# Comma-separated CORS origins for the frontend's hostname(s); unset -> no CORS middleware.
# Include http://localhost:5173 for the local `npm run dev` loop (Vite's dev server origin) —
# without it the browser blocks every request with a CORS error before auth is even checked.
# PERSEVERER_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Where the DuckDB sqlite extension is baked in at Docker build time (api.Dockerfile). Leave
# unset for host-side dev tooling — DuckDB's own default cache/INSTALL is fine there.
# PERSEVERER_DUCKDB_EXTENSION_DIR=

# --- Phase 5: per-athlete login + frontend ---
# Signs session JWTs issued by POST /api/v1/auth/login. Unset -> that route fails closed (503),
# same fail-closed contract as PERSEVERER_API_KEY. Generate with e.g. `openssl rand -hex 32`.
# PERSEVERER_JWT_SECRET=
PERSEVERER_JWT_EXPIRY_DAYS=30
# Frontend's runtime-config.js is regenerated from this at container start (never baked into
# the Vite build — see docs/adr/0008-phase-5-frontend.md). Leave unset for local `npm run dev`,
# which uses the committed frontend/public/config.js default (http://localhost:8008) instead.
# PERSEVERER_API_BASE_URL=

# --- Eufy Life body-composition sync (adapters/eufy.py) ---
# Same Eufy Life app account/device as any existing eufy-health-sync-style tooling. All four
# optional together -- sync_eufy() just skips (logs, doesn't error) when unset.
# PERSEVERER_EUFY_EMAIL=
# PERSEVERER_EUFY_PASSWORD=
# PERSEVERER_EUFY_DEVICE_ID=
# PERSEVERER_EUFY_CUSTOMER_ID=

# --- Dev (Windows/Podman Desktop) port publishing ---
# Host port the API is published on for local browsing/curl. Not used on the NAS (proxy-only
# ingress — see docs/DEPLOY.md). Deliberately not 8000 — that's a common default other local
# tools/dev servers grab too, and did on this machine.
DEV_API_PUBLISHED_PORT=8008
DEV_FRONTEND_PUBLISHED_PORT=5173

# --- NAS-only (compose.nas.yml) ---
# Host path on the DS1019+ for the data volume (SQLite + raw archive + Parquet). Must be
# owned by NAS_UID:NAS_GID — see docs/DEPLOY.md for the chown step.
NAS_DATA_DIR=/volume1/docker/perseverer/data
NAS_UID=1000
NAS_GID=1000

# --- Image tags (GHCR) — NAS-only, not read by compose.yaml/compose.override.yml for local
# dev builds (which always tag as perseverer-{api,worker,frontend}:local). Set by CI,
# referenced only by compose.nas.yml when pulling. Must be all-lowercase (OCI naming rule).
GHCR_IMAGE_PREFIX=ghcr.io/jcatrouillet/perseverer
IMAGE_TAG=latest

# --- Reserved, not yet consumed by code (documented here so the name doesn't drift) ---
# The reverse proxy's IP — X-Forwarded-* headers would be trusted ONLY from this address, once
# wired into uvicorn's --forwarded-allow-ips (needs an api.Dockerfile CMD change; see ADR 0006).
# PERSEVERER_TRUSTED_PROXY_IP=
