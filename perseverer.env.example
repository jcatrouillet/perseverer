# Perseverer configuration — the only file you need to edit.
#
# Copy to `perseverer.env` (git-ignored) and fill in the "Required" section. Everything else is
# optional and shows its default. The same file is read by:
#   - the app on the dev host (`uv run ...`, the Vite dev server),
#   - `docker compose --env-file perseverer.env up` / `podman compose --env-file perseverer.env up`,
#   - `scripts/install-production.sh`, which renders the systemd Quadlet units from it and
#     installs it next to them on the production server.
# Values are plain KEY=value (no quotes, no spaces around `=`).

# =============================================================================================
# Required
# =============================================================================================

# The public URL people and AI clients use to reach Perseverer, without a trailing slash, e.g.
# https://perseverer.example.com. Used for share links, the calendar feed and the MCP OAuth
# issuer. On the dev host, http://localhost:5173.
PERSEVERER_PUBLIC_BASE_URL=http://localhost:5173

# Secrets. Generate each with: openssl rand -hex 32
# Shared API key (X-API-Key header) for scripts and MCP clients, acting as the first athlete.
PERSEVERER_API_KEY=
# Signs login sessions.
PERSEVERER_JWT_SECRET=

# IANA time zone for scheduled jobs (daily sync, backups, emails) and container clocks.
PERSEVERER_SCHEDULE_TIMEZONE=UTC

# =============================================================================================
# Infrastructure
# =============================================================================================

# Container images: <prefix>/perseverer-{api,worker,frontend}:<tag>. The default points at the
# images CI publishes for this repository; change it if you build and push your own.
PERSEVERER_IMAGE_PREFIX=ghcr.io/jcatrouillet
PERSEVERER_IMAGE_TAG=latest

# Where the data directory (raw archive, SQLite, Parquet) lives on the production server.
# `~` is expanded by the install script. The dev host always uses ./data.
PERSEVERER_HOST_DATA_DIR=~/perseverer/data

# Host ports. Point your reverse proxy at the frontend port; it forwards API, MCP and share
# traffic to the API port itself, so the API port does not need to be exposed.
PERSEVERER_HOST_FRONTEND_PORT=8080
PERSEVERER_HOST_API_PORT=8000

# Browser origins allowed to call the API cross-origin (comma-separated). Only needed when the
# frontend and API are on different origins, e.g. the Vite dev server: http://localhost:5173.
PERSEVERER_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Override the API URL the web app calls. Leave empty to use the page's own origin (the normal
# production setup). On the dev host the Vite server defaults to
# http://localhost:<PERSEVERER_HOST_API_PORT>.
PERSEVERER_API_BASE_URL=

# =============================================================================================
# Optional integrations (each block is all-or-nothing; leave empty to disable)
# =============================================================================================

# Map tiles: a CARTO basemaps key (https://carto.com/basemaps). Maps work without one, subject
# to CARTO's anonymous fair-use limits.
PERSEVERER_CARTO_API_KEY=

# Email reports and shoe alerts: SMTP relay. Port 587 uses starttls, 465 uses ssl.
PERSEVERER_SMTP_HOST=
PERSEVERER_SMTP_PORT=587
PERSEVERER_SMTP_SECURITY=starttls
PERSEVERER_SMTP_USERNAME=
PERSEVERER_SMTP_PASSWORD=
PERSEVERER_SMTP_FROM=

# Nightly backup: rsync over SSH to another machine. Run the one-time key setup in
# docs/DEPLOY.md first. The SSH key directory is mounted read-only into the worker.
PERSEVERER_BACKUP_HOST=
PERSEVERER_BACKUP_USER=
PERSEVERER_BACKUP_PATH=
PERSEVERER_HOST_BACKUP_SSH_DIR=~/perseverer/backup-ssh

# Staleness and ingest alerts: a URL that receives a JSON POST.
PERSEVERER_STALENESS_WEBHOOK_URL=

# Eufy smart scale for the first athlete (other athletes: Settings → External tools).
PERSEVERER_EUFY_EMAIL=
PERSEVERER_EUFY_PASSWORD=
PERSEVERER_EUFY_DEVICE_ID=
PERSEVERER_EUFY_CUSTOMER_ID=

# =============================================================================================
# Tuning (defaults shown; uncomment to change)
# =============================================================================================

# Shown by GET /version; set to production on the server.
# PERSEVERER_ENVIRONMENT=development
# PERSEVERER_LOG_LEVEL=INFO

# Daily sync (Garmin, Eufy, Kaya) at hour:minute in PERSEVERER_SCHEDULE_TIMEZONE, ± jitter seconds.
# PERSEVERER_SCHEDULE_HOUR=4
# PERSEVERER_SCHEDULE_MINUTE=15
# PERSEVERER_SCHEDULE_JITTER_S=600
# Garmin Connect: days re-fetched each sync, pacing, and the hourly request cap.
# PERSEVERER_GARMIN_ROLLING_WINDOW_DAYS=10
# PERSEVERER_GARMIN_REQUEST_INTERVAL_S=3.0
# PERSEVERER_GARMIN_MAX_REQUESTS_PER_HOUR=300
# Alerts: days without a Garmin sync before "critical"; days before asking for a fresh export.
# PERSEVERER_GARMIN_STALE_ESCALATE_DAYS=7
# PERSEVERER_EXPORT_FRESHNESS_DAYS=90

# Planned workouts due within this many days are pushed to Garmin by a daily job.
# PERSEVERER_PLANNED_WORKOUT_PUSH_WINDOW_DAYS=7
# PERSEVERER_WORKOUT_PUSH_SCHEDULE_HOUR=4
# PERSEVERER_WORKOUT_PUSH_SCHEDULE_MINUTE=45

# Backup time and how many local database snapshots to keep (the remote copy keeps everything).
# PERSEVERER_BACKUP_SCHEDULE_HOUR=3
# PERSEVERER_BACKUP_SCHEDULE_MINUTE=30
# PERSEVERER_BACKUP_KEEP_LOCAL_SNAPSHOTS=7
# Only if the backup must use a key other than the mounted directory's default id_ed25519.
# PERSEVERER_BACKUP_SSH_KEY_PATH=

# Email report time; weekly on this weekday, monthly on the month's last day.
# PERSEVERER_EMAIL_REPORT_HOUR=18
# PERSEVERER_EMAIL_REPORT_MINUTE=0
# PERSEVERER_EMAIL_REPORT_WEEKLY_DAY_OF_WEEK=sun

# Login session lifetime in days.
# PERSEVERER_JWT_EXPIRY_DAYS=30
