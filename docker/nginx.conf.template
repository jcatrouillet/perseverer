# Rendered at container start by the nginx image's envsubst step (only PERSEVERER_* variables,
# see NGINX_ENVSUBST_FILTER in frontend.Dockerfile), so the API port comes from perseverer.env.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Pre-compressed assets are generated at build time (the Vite build), so no CPU is spent
    # compressing on the fly.
    # gzip_static serves the original file untouched when no .gz sibling exists yet.
    gzip_static on;
    gzip_vary on;

    # host.containers.internal is rootless Podman's built-in host-gateway alias -- reaches the
    # API container's host-published port with no shared Podman network/Quadlet change needed.
    # A share link (api/routers/share.py) needs to resolve on this same origin for a usable,
    # memorable URL, so this one path is forwarded to the API container instead of falling
    # through to the SPA's own index.html like everything else here.
    location /share/ {
        proxy_pass http://host.containers.internal:${PERSEVERER_HOST_API_PORT};
        proxy_set_header Host $host;
    }

    # Everything under /api/ (every REST route -- they all carry their own /api/v1 prefix, so no
    # rewrite needed here) and the MCP server's own /mcp path proxy straight through to the same
    # API container. This is what lets the whole app live behind one single external origin --
    # the *outer* reverse proxy (docs/DEPLOY.md) no longer needs a second HTTPS rule/port for the
    # API at all, just this one frontend origin. Kept as two blocks rather than one broader
    # prefix so a future route that isn't under either path (there is none today) fails loudly
    # instead of silently proxying.
    location /api/ {
        proxy_pass http://host.containers.internal:${PERSEVERER_HOST_API_PORT};
        proxy_set_header Host $host;
    }

    location /mcp {
        proxy_pass http://host.containers.internal:${PERSEVERER_HOST_API_PORT};
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # Streamable HTTP is a long-lived, server-sent-events-carrying connection per session --
        # nginx's own 60s read timeout would silently cut a real MCP session short, and its
        # default response buffering would hold an SSE chunk until the buffer fills or the
        # connection closes instead of forwarding it as the client sent it.
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # The MCP server's OAuth 2.1 authorization server (auth/oauth.py, docs/ARCHITECTURE.md):
    # discovery documents, dynamic client registration, authorize/token/revoke, and the login
    # page the authorize step sends the browser to. All served by the API container, so a remote
    # MCP client (claude.ai's custom connector) can authenticate against this one origin. Exact
    # paths on purpose -- none of them overlap a frontend route.
    location ~ ^/(\.well-known/oauth-|authorize$|token$|register$|revoke$|oauth/) {
        proxy_pass http://host.containers.internal:${PERSEVERER_HOST_API_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
